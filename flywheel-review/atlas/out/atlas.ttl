    atlas:checkedOn "2026-11-14"^^xsd:date ;
    atlas:checkedText "2026-11-14, `x3d.loom@162ab18`, Python 3.13.18 (the second line is run against this file as published)" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/02-loom-laws.md?plain=1#L336> ;
    atlas:inChapter <chapter/02> ;
    rdfs:label "D-LAW-2 Re-derive the counts" ;
    atlas:level "L2" ;
    atlas:line 336 ;
    prov:wasQuotedFrom <doc/x3d.docs@ff0565e/docs/learn/02-loom-laws.md> ;
    atlas:status "ran" ;
    atlas:task "From `LOOM-v1.md` and from this chapter, count the laws, the failure modes, and the `code:` and `process:` checks." ;
    atlas:title "Re-derive the counts" ;
    atlas:usesTool <tool/python@3.13.18> ;
    atlas:verify "run in a checkout of `x3d.loom` with this chapter saved as `02-loom-laws.md`: ```python import re t = open(\"LOOM-v1.md\", encoding=\"utf-8\").read().split(\"\\n\") def rows(a, b): i = next(k for k, l in enumerate(t) if l.startswith(a)); j = next(k for k, l in enumerate(t) if l.startswith(b)) return [int(m.group(1)) for l in t[i:j] if (m := re.match(r\"\\| (\\d+) \\|\", l))] laws, fms = rows(\"## 3. The laws\", \"## 4. The loop\"), rows(\"## 8. Known failure modes\", \"## 9. Planned\") print(len(laws), laws == list(range(1, 45)), len(fms), fms == list(range(1, 161))) doc = open(\"02-loom-laws.md\", encoding=\"utf-8\").read() cells = re.findall(r\"^\\| (\\d+) \\| \\*\\*.*\\| (code|process):\", doc, re.M) print(len(cells), sum(c == \"code\" for _, c in cells), sum(c == \"process\" for _, c in cells)) ```" .

