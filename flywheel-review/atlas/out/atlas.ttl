<drill/D-UNR-1> a atlas:Drill ;
    atlas:answer "`det P = -1`, `det Q = +1` (so Q is a rotation and cannot fix handedness); `P R P = [[0,0,-1],[0,1,0],[1,0,0]]`, axis-angle `0 -1 0 1.5708`." ;
    atlas:checkedOn "2026-11-14"^^xsd:date ;
    atlas:checkedText "2026-11-14 Python 3 (the converters' own `ue_rot`, `mm`, `axis_angle`)." ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/12-unreal-tier1.md?plain=1#L528> ;
