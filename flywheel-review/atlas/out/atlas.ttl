<law/38> a atlas:Law ;
    atlas:checkKind "process" ;
    atlas:checkText "process: same sha256, a coverage manifest, a shape witness per beat" ;
    atlas:citesSource <source/RB1> ;
    dcterms:source <https://github.com/hagopjay/x3d.loom/blob/ba301533d7b66eb8fe5e691524a551ef01c58de1/LOOM-v1.md?plain=1#L128> ;
    atlas:evidenceGrade <grade/C> ;
    atlas:evidenceText "both rebuilds drew from converted copies; merged build reads 48 of 48 ROUTEs, cloth mask IoU 0.976 to 0.992 (fm 115, 123)" ;
    atlas:forbids "A second renderer fed from an export that can drift from the master; renderer-only geometry" ;
    atlas:headline "One master, many renderers" ;
    atlas:inTheme <theme/I> ;
    rdfs:label "Law 38: One master, many renderers" ;
    atlas:line 128 ;
    atlas:n 38 ;
    atlas:paidForBy <fm/115>, <fm/123> ;
    atlas:paidForByText "Both rebuilds drew from converted copies: one 50 % larger than the gzipped X3D, one carrying geometry and a moon the scene did not hold and a miswired reveal. The merged build reads 48 of 48 ROUTEs from the X3D, cloth mask IoU 0.976 to 0.992 at 10 beats (C, failure modes 115, 123; [RB1])" ;
    prov:wasQuotedFrom <doc/x3d.loom@ba30153/LOOM-v1.md> ;
    atlas:text "A second renderer reads the validated X3D itself, never a converted copy. Parity between renderers is the same sha256, the reader's coverage manifest (every node and ROUTE read, or named as skipped) and a shape witness per beat (a mask's IoU); never a pixel hash across renderers" ;
    atlas:violation "a second renderer fed from a drifting export; a pixel hash across renderers" .

<law/39> a atlas:Law ;
