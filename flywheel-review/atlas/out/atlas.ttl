<drill/D-BAB-6> a atlas:Drill ;
    atlas:answer "radius error 2.2e-16; weighted midpoint (0.7071, 0.7071, 0), unweighted (0.75, 0.75, 0). X_ITE 16.6.0 returns the unweighted one (0.75, 0.75, 0), which a rational B-spline does not." ;
    atlas:atPin <pin/x3d.loom@4887a98> ;
    atlas:checkedOn "2026-11-14"^^xsd:date ;
    atlas:checkedText "2026-11-14 Node, `x3d.loom@4887a98`" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/08-babylon-bridge.md?plain=1#L889> ;
