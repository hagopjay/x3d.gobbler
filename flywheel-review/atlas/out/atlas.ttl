<drill/D-BAB-8> a atlas:Drill ;
    atlas:answer "cells = floor(8 x scale) times floor(4 x scale), two triangles per cell: 64, 16, 256 and 4 (floor(2.4) x floor(1.2) = 2 x 1 cells). B leaves the set and returns to its own 6 x 6 x 2 = 72 triangles. The spec records 64, 16, 256, 4 and 72; both engines agree." ;
    atlas:atPin <pin/x3d.loom@4887a98> ;
    atlas:checkedOn "2026-11-14"^^xsd:date ;
    atlas:checkedText "2026-11-14 `x3d.loom@4887a98`, `X_ITE 16.6.0`, Chromium 153.0.8010.12 SwiftShader, Babylon 9.32.0" ;
