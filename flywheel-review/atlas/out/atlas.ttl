<drill/D-PHY-1> a atlas:Drill ;
    atlas:answer "explicit: final +10.89, max 11.01 (energy has grown elevenfold). Symplectic: final +0.0002, max 0.0150 (bounded oscillation around the shadow energy)." ;
    atlas:checkedOn "2026-11-14"^^xsd:date ;
    atlas:checkedText "`2026-11-14 python3 -I numpy 2.5.3`: explicit 10.8933 and 11.0130, symplectic 0.0002 and 0.0150." ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/13-physics.md?plain=1#L456> ;
    atlas:inChapter <chapter/13> ;
    rdfs:label "D-PHY-1 Symplectic against explicit Euler on a pendulum" ;
    atlas:level "L2" ;
    atlas:line 456 ;
    prov:wasQuotedFrom <doc/x3d.docs@ff0565e/docs/learn/13-physics.md> ;
    atlas:status "ran" ;
    atlas:task "Integrate a pendulum (L = 1, theta0 = 1 rad, h = 0.01, T = 100 s) with explicit Euler and with symplectic Euler. Report final and maximum relative energy change `(E - E0)/E0`." ;
    atlas:title "Symplectic against explicit Euler on a pendulum" ;
    atlas:verify "```python def pend(method, h, T, th0=1.0, L=1.0): th, w = th0, 0.0 E = lambda th, w: 0.5*L*L*w*w + g*L*(1-math.cos(th)) E0 = E(th, w); Es = [] for _ in range(int(round(T/h))): if method == 'explicit': a = -g/L*math.sin(th); th, w = th + h*w, w + h*a else: w += h*(-g/L*math.sin(th)); th += h*w Es.append(E(th, w)) return E0, np.array(Es) for m in ('explicit', 'symplectic'): E0, Es = pend(m, 0.01, 100) print(m, (Es[-1]-E0)/E0, np.max(abs(Es-E0))/E0) ```" .

