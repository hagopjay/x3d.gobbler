@base <https://x3datlas.example/0/> .
@prefix atlas: <https://x3datlas.example/0#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<chapter/01> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.docs@f172f67>, <pin/x3d.loom@162ab18>, <pin/x3d_mcp@535fdac>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "TH" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/01-the-tether.md> ;
    atlas:file "docs/learn/01-the-tether.md" ;
    atlas:grade <grade/L> ;
    rdfs:label "01. The tether" ;
    atlas:n 1 ;
    atlas:say "X3D can be held to account because a program can name exactly what is wrong with a file, a second program can show what the file draws, and the record of both checks can travel inside the file; this holds for structure and behaviour, while appearance and intent still need a renderer and a person." ;
    atlas:title "The tether" .

<chapter/02> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.docs@f172f67>, <pin/x3d.loom@0244784>, <pin/x3d.loom@162ab18>, <pin/x3d.loom@babba96> ;
    atlas:code "LAW" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/02-loom-laws.md> ;
    atlas:file "docs/learn/02-loom-laws.md" ;
    rdfs:label "02. The Loom laws" ;
    atlas:n 2 ;
    atlas:requires <chapter/01> ;
    atlas:say "the Loom is 44 numbered laws and 160 numbered failure modes, each paid for by a recorded failure; this chapter indexes them by number so you can find the law that forbids a mistake, the incident that created it, and the check that catches it. [L] (the counts are [C], parsed from the file)" ;
    atlas:title "The Loom laws" .

<chapter/03> a atlas:Chapter ;
    atlas:citesPin <pin/x3d-blender-io@ab99988>, <pin/x3d.docs@f172f67>, <pin/x3d.loom@162ab18>, <pin/x3d_mcp@74da0ec>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "VAL" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/03-validator-and-gates.md> ;
    atlas:file "docs/learn/03-validator-and-gates.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "03. The validator and the gates" ;
    atlas:n 3 ;
    atlas:requires <chapter/01>, <chapter/02> ;
    atlas:say "A validator is a ladder, not a verdict: every rung names what it checked, the rungs below the renderer cannot see \"looks right\", and a verdict without a commit and a schema version is a rumour." ;
    atlas:title "The validator and the gates" .

<chapter/04> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.docs@f172f67>, <pin/x3d_mcp@74da0ec>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "MCP" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/04-mcp-for-agents.md> ;
    atlas:file "docs/learn/04-mcp-for-agents.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "04. x3d_mcp as the agent interface" ;
    atlas:n 4 ;
    atlas:requires <chapter/01>, <chapter/03> ;
    atlas:say "x3d_mcp gives a model 53 callable tools whose answers are small, structured and checkable, tells it the canonical path on connect, and keeps big documents and hostile queries out of its context with guards that live in the tool, not in the prompt." ;
    atlas:title "x3d_mcp as the agent interface" .

<chapter/05> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.demo@d10b457>, <pin/x3d.docs@f172f67>, <pin/x3d_mcp@13121b6>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "SEM" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/05-semantic-layer.md> ;
    atlas:file "docs/learn/05-semantic-layer.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "05. The semantic layer: RDF, OWL, SPARQL, SHACL on X3D" ;
    atlas:n 5 ;
    atlas:requires <chapter/01>, <chapter/03> ;
    atlas:say "An X3D scene can be turned into a graph of facts, questioned with SPARQL, held to SHACL shapes and (carefully) reasoned over, but the ontology only proposes, the shapes dispose and the validators gate; every result names a node, a check id and an instrument." ;
    atlas:title "The semantic layer: RDF, OWL, SPARQL, SHACL on X3D" .

<chapter/06> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.demo@d10b457>, <pin/x3d.docs@f172f67>, <pin/x3d.loom@162ab18>, <pin/x3d.xray@8fa6845>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "XIT" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/06-xite-the-oracle.md> ;
    atlas:file "docs/learn/06-xite-the-oracle.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "06. X_ITE, the reference renderer" ;
    atlas:n 6 ;
    atlas:requires <chapter/01>, <chapter/03> ;
    atlas:say "X_ITE is the second program that tells you what a scene draws and what its events do, and it is a good oracle only when you name its patch, its browser and its options, drive it with guarded code, and remember that it is a renderer with its own extensions, not a validator." ;
    atlas:title "X_ITE, the reference renderer" .

<chapter/07> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.castle@d70e00c>, <pin/x3d.xray@8fa6845>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "XRY" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/07-xray.md> ;
    atlas:file "docs/learn/07-xray.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "07. x3d.xray, the X-ray method" ;
    atlas:n 7 ;
    atlas:requires <chapter/01>, <chapter/03>, <chapter/06> ;
    atlas:say "x3d.xray turns the git history of a family of repositories into one X3D scene whose every number is computed by code, graded by checks declared before the data is read, and re-derived by a second reader; on a repository too thin to grade, its honest output is \"not run\"." ;
    atlas:title "x3d.xray, the X-ray method" .

<chapter/08> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.demo@d10b457>, <pin/x3d.docs@f172f67>, <pin/x3d.loom@108a282>, <pin/x3d.loom@1192dd4>, <pin/x3d.loom@162ab18>, <pin/x3d.loom@38530ab>, <pin/x3d.loom@4887a98>, <pin/x3d.loom@60824ce>, <pin/x3d.loom@72a4bca>, <pin/x3d.loom@80388ce>, <pin/x3d.loom@8a1e769>, <pin/x3d.loom@95eda37>, <pin/x3d.loom@9f969d2>, <pin/x3d.loom@a6e3d31>, <pin/x3d.loom@bfeba57>, <pin/x3d.loom@c80cecd>, <pin/x3d.loom@c9b7695>, <pin/x3d.loom@cd71796>, <pin/x3d.loom@ed1bed8> ;
    atlas:code "BAB" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/08-babylon-bridge.md> ;
    atlas:file "docs/learn/08-babylon-bridge.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "08. The Babylon bridge" ;
    atlas:n 8 ;
    atlas:requires <chapter/01>, <chapter/02>, <chapter/06> ;
    atlas:say "one X3D file is the master, our own reader runs its events, and Babylon on WebGPU only paints the result; every picture is a claim against X_ITE on a named rig, every fallback says so on screen, and nothing about speed has been measured." ;
    atlas:title "The Babylon bridge" .

<chapter/09> a atlas:Chapter ;
    atlas:citesPin <pin/castle-engine@48ce617>, <pin/x3d.castle@d70e00c>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "CAS" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/09-castle-engine.md> ;
    atlas:file "docs/learn/09-castle-engine.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "09. Castle Game Engine as an X3D host" ;
    atlas:n 9 ;
    atlas:requires <chapter/01>, <chapter/03>, <chapter/06> ;
    atlas:say "Castle is a native Pascal engine whose internal model is the X3D node graph, which makes it the best-mapped host we examined for seam knowledge and traps; nothing measured here shows it leading on node coverage, conformance, fidelity or standard-setting, and the one comparator we ran (X_ITE) is ahead on fidelity and, at the name rung, on node coverage." ;
    atlas:title "Castle Game Engine as an X3D host" .

<chapter/10> a atlas:Chapter ;
    atlas:citesPin <pin/x3d-blender-io@ab99988>, <pin/x3d.docs@f172f67>, <pin/x3d_mcp@b4efcd3> ;
    atlas:code "BLE" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/10-blender-pipeline.md> ;
    atlas:file "docs/learn/10-blender-pipeline.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "10. Blender as the studio: x3d-blender-io and the sci-vis knowledge base" ;
    atlas:n 10 ;
    atlas:requires <chapter/01>, <chapter/03>, <chapter/06>, <chapter/08> ;
    atlas:say "Blender is where a scene is modelled, lit and baked, and the add-on is the door it leaves through; every exit can be gated by a validator and a second renderer, a re-export is valid even when the source was not, so what you score is fidelity, with each number tied to a named rig." ;
    atlas:title "Blender as the studio: x3d-blender-io and the sci-vis knowledge base" .

<chapter/11> a atlas:Chapter ;
    atlas:citesPin <pin/x3d-blender-io@ab99988>, <pin/x3d.docs@f172f67> ;
    atlas:code "GLT" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/11-gltf-usd-khronos.md> ;
    atlas:file "docs/learn/11-gltf-usd-khronos.md" ;
    rdfs:label "11. glTF, USD and Khronos: what survives and what the gate proves" ;
    atlas:n 11 ;
    atlas:requires <chapter/01>, <chapter/03> ;
    atlas:say "an X3D scene that goes through Blender to a glb keeps its geometry, materials, lights, cameras and fixed animation, loses its behaviour (ROUTEs, Scripts, PROTOs, sensors) and its authoring identity unless you pay to carry it, and the Khronos validator proves only that the glb is well-formed, never that the scene is in it. [C] for the validator behaviour re-run below, [L] for what each carrier keeps." ;
    atlas:title "glTF, USD and Khronos: what survives and what the gate proves" .

<chapter/12> a atlas:Chapter ;
    atlas:citesPin <pin/x3d-blender-io@54aba0c>, <pin/x3d-blender-io@ab99988>, <pin/x3d.lab@70551e8> ;
    atlas:code "UNR" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/12-unreal-tier1.md> ;
    atlas:file "docs/learn/12-unreal-tier1.md" ;
    rdfs:label "12. Unreal as a tier-1 X3D framework" ;
    atlas:n 12 ;
    atlas:requires <chapter/01>, <chapter/06>, <chapter/08>, <chapter/11> ;
    atlas:say "Unreal is a plausible tier-1 endpoint for *rendering* an X3D scene through a glb, it cannot run X3D behaviour without a plugin that does not exist, and today every Unreal claim in this base is read, not run: no Unreal 5.8 install and no GPU run stand behind any of them. [L] for the architecture, [S] for every Unreal behaviour claim, [C] only for the conversions and arithmetic re-run on 2026-11-14." ;
    atlas:title "Unreal as a tier-1 X3D framework" .

<chapter/13> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.demo@d10b457>, <pin/x3d.docs@f172f67>, <pin/x3d.loom@162ab18> ;
    atlas:code "PHY" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/13-physics.md> ;
    atlas:file "docs/learn/13-physics.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "13. Physics in X3D: RigidBodyPhysics, PhysX, MuJoCo and the Ten Minute Physics ports" ;
    atlas:n 13 ;
    atlas:requires <chapter/02>, <chapter/03> ;
    atlas:say "A valid X3D physics scene says nothing about whether the simulation is stable, deterministic or right; the physics analogue of the validator is a run record whose hashes replay, whose references are exact, and whose controls are shown able to fail." ;
    atlas:title "Physics in X3D: RigidBodyPhysics, PhysX, MuJoCo and the Ten Minute Physics ports" .

<chapter/14> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.docs@f172f67>, <pin/x3d.xray@8fa6845> ;
    atlas:code "MET" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/14-methods.md> ;
    atlas:file "docs/learn/14-methods.md" ;
    atlas:grade <grade/L> ;
    rdfs:label "14. Methods: how to learn, test and extend this base" ;
    atlas:n 14 ;
    atlas:say "You learn X3D here by predicting a result, running the tool, comparing, grading the gap and recording a rule with a falsifier; a heuristic you cannot falsify is not in the ledger." ;
    atlas:title "Methods: how to learn, test and extend this base" .

<chapter/15> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.loom@1d1109e>, <pin/x3d.loom@3acc825> ;
    atlas:code "ANM" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/15-animation-timelines.md> ;
    atlas:file "docs/learn/15-animation-timelines.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "15. Animation timelines: Theatre.js and GSAP to X3D" ;
    atlas:n 15 ;
    atlas:requires <chapter/06>, <chapter/08> ;
    atlas:say "An authored timeline becomes X3D as a TimeSensor, interpolators and ROUTEs, and the only honest way to ship it is to measure the bake against the tool, because interpolators are straight lines and ColorInterpolator blends in HSV." ;
    atlas:title "Animation timelines: Theatre.js and GSAP to X3D" .

<chapter/16> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.demo@9c96896>, <pin/x3d.loom@d8e02ef>, <pin/x3d_mcp@60b9474> ;
    atlas:code "ZOD" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/16-typed-x3d-zod.md> ;
    atlas:file "docs/learn/16-typed-x3d-zod.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "16. Typed X3D: Zod, JSON Schema and the model that can be held to it" ;
    atlas:n 16 ;
    atlas:requires <chapter/01>, <chapter/03>, <chapter/04> ;
    atlas:say "The Web3D X3D 4.0 JSON Schema can be compiled into Zod schemas and TypeScript types (364 definitions, one in-memory correction), so a model's X3D JSON is checked in code with the exact path of every fault, shrunk to the few nodes a model needs for constrained decoding, and compared with the XSD and the semantic layer; four validators agreed on all 1,432 convertible repository scenes, and the 190 scenes where the XSD and the JSON Schema differ are almost all faults in the standards or in our converter, not in Zod." ;
    atlas:title "Typed X3D: Zod, JSON Schema and the model that can be held to it" .

<chapter/17> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.docs@acd4e25>, <pin/x3d.loom@1e884b6>, <pin/x3d.loom@56340c2> ;
    atlas:code "ENG" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/17-physics-engines.md> ;
    atlas:file "docs/learn/17-physics-engines.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "17. Pluggable physics engines behind RigidBodyPhysics: Rapier, cannon-es and the built-in solver" ;
    atlas:n 17 ;
    atlas:requires <chapter/08>, <chapter/13> ;
    atlas:say "The same RigidBodyPhysics file can be stepped by four engines, and the only way to tell them apart is to run each against a closed-form answer, a repeat, a second host and a sensor that must fire; the winner differs per question, and two of the engines carry defects that only a measurement shows." ;
    atlas:title "Pluggable physics engines behind RigidBodyPhysics: Rapier, cannon-es and the built-in solver" .

<chapter/18> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.demo@272f4fd>, <pin/x3d.docs@acd4e25>, <pin/x3d.lab@a7af249>, <pin/x3d.loom@5f59349> ;
    atlas:code "PTR" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/18-three-pathtracer.md> ;
    atlas:file "docs/learn/18-three-pathtracer.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "18. Path-tracing X3D: three-gpu-pathtracer as a light-transport reference" ;
    atlas:n 18 ;
    atlas:requires <chapter/02>, <chapter/06>, <chapter/08>, <chapter/12> ;
    atlas:say "A path tracer is a second opinion on how an X3D scene is lit, not a better X_ITE: it agrees with X_ITE when it is limited to direct light (Cornell box, 1 bounce, FLIP 0.142), moves toward Cycles as bounces are added, and fails a \"within the reference spread\" bound on a scene whose lighting it does not model (PBR grid, 0.743 against a bound of 0.349)." ;
    atlas:title "Path-tracing X3D: three-gpu-pathtracer as a light-transport reference" .

<chapter/19> a atlas:Chapter ;
    atlas:citesPin <pin/x3d-blender-io@54aba0c>, <pin/x3d.castle@0a1073f>, <pin/x3d.loom@b6a3650> ;
    atlas:code "GTO" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/19-gltf-tooling.md> ;
    atlas:file "docs/learn/19-gltf-tooling.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "19. glTF tooling that keeps X3D identity: glTF-Transform, meshopt, Draco, KTX2 and the gates around them" ;
    atlas:n 19 ;
    atlas:requires <chapter/03>, <chapter/11> ;
    atlas:say "a glb from the Blender add-on can be cut to about a third of its size, or to a tenth of it on a mesh-heavy scene, and still be proven to carry every DEF name, camera, light, material and animation channel it started with, but only if the stock glTF-Transform steps that erase names are wrapped and the result is checked by gates the Khronos validator does not have." ;
    atlas:title "glTF tooling that keeps X3D identity: glTF-Transform, meshopt, Draco, KTX2 and the gates around them" .

<chapter/20> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.loom@7c69356>, <pin/x3d.loom@7c818e3> ;
    atlas:code "WGC" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/20-webgpu-compute.md> ;
    atlas:file "docs/learn/20-webgpu-compute.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "20. Compute on the GPU: WebGPU kernels for X3D workloads" ;
    atlas:n 20 ;
    atlas:requires <chapter/02>, <chapter/08> ;
    atlas:say "Five X3D features (ParticleSystem, HAnim skinning, VolumeData, NURBS patches, GaussianSplats) have per-frame arithmetic that maps to WGSL compute kernels one thread per item, and each kernel is trustworthy only because it matches an independent CPU twin, fails when a bug is planted in it, and is timed three ways that disagree." ;
    atlas:title "Compute on the GPU: WebGPU kernels for X3D workloads" .

<chapter/21> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.loom@a9640eb> ;
    atlas:code "YJS" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/21-yjs-collaboration.md> ;
    atlas:file "docs/learn/21-yjs-collaboration.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "21. Many hands on one scene: Yjs, CRDTs and the X3D scene graph" ;
    atlas:n 21 ;
    atlas:requires <chapter/02>, <chapter/04>, <chapter/08> ;
    atlas:say "A scene graph can be held as a Yjs document so that people, browsers and an LLM agent edit one X3D scene at the same time and always converge, provided the tree is stored as a flat node table with a parent register and the export is made order-independent." ;
    atlas:title "Many hands on one scene: Yjs, CRDTs and the X3D scene graph" .

<chapter/22> a atlas:Chapter ;
    atlas:citesPin <pin/x3d.docs@3aab064>, <pin/x3d.docs@a9b5f33>, <pin/x3d.loom@0752865>, <pin/x3d.loom@34bc760>, <pin/x3d.loom@7a7d657>, <pin/x3d.loom@be7c481>, <pin/x3d.ml@8e2e8da>, <pin/x3d_mcp@c6681fe>, <pin/x3d_mcp@dcf0815> ;
    atlas:code "JEV" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/22-typed-judgments-jev.md> ;
    atlas:file "docs/learn/22-typed-judgments-jev.md" ;
    atlas:grade <grade/L> ;
    rdfs:label "22. Typed judgments: what Jev teaches X3D, and what it must never be trusted with" ;
    atlas:n 22 ;
    atlas:requires <chapter/01>, <chapter/03>, <chapter/04>, <chapter/05> ;
    atlas:say "A typed judge such as Jev belongs behind exact code, not in front of it: answer by lookup what code can answer, run the validator twin for the rest, calibrate the judge's probabilities (not its \"confidence\") against validator verdicts, and keep scene text out of its state." ;
    atlas:title "Typed judgments: what Jev teaches X3D, and what it must never be trusted with" .

<chapter/23> a atlas:Chapter ;
    atlas:citesPin <pin/x3d-blender-io@044bea3>, <pin/x3d.castle@5b13f70>, <pin/x3d.loom@be7c481>, <pin/x3d.ml@305fd60>, <pin/x3d_mcp@e55375f> ;
    atlas:code "TRC" ;
    dcterms:source <https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/23-traceability-lineage.md> ;
    atlas:file "docs/learn/23-traceability-lineage.md" ;
    atlas:grade <grade/C> ;
    rdfs:label "23. Traceability: a quote beside every value, and the lineage stack around it" ;
    atlas:n 23 ;
    atlas:requires <chapter/01>, <chapter/03>, <chapter/22> ;
    atlas:say "Make whoever writes a value copy the exact words it came from, and let plain code answer three questions (is the quote in the source, is the value in the quote, where is it); then record the answer in the scene's own hash chain, recompute it on audit, and say out loud what it cannot show: that the quote is the right place, that the value is true, or who wrote the record." ;
    atlas:title "Traceability: a quote beside every value, and the lineage stack around it" .

