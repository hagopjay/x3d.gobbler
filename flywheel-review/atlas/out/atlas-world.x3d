<Transform translation='40.123 5.5 -5.515'><TouchSensor DEF='T_drill_D_TRC_3' description="D-TRC-3 First hit or the field's node (L2), ran."/><Shape><Appearance USE='A_drill_ran'/><Box USE='G_cube'/></Shape></Transform>
