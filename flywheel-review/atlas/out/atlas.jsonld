  },
  {
   "@id": "fm/155",
   "@type": "FailureMode",
   "n": 155,
   "label": "Failure mode 155",
   "failure": "A control's caption disagreed with the code: the spatial-hash control cell was 0.30 of a ball diameter, the page said 0.6 (2997 missed pairs against 1057)",
   "fix": "Generate captions and numbers from the variables the code ran with",
   "sourceText": "[x3d.demo PRs #19 to #25, v5/ERRATA-v1-v4.md; C]",
   "definedAt": "https://github.com/hagopjay/x3d.loom/blob/ba301533d7b66eb8fe5e691524a551ef01c58de1/LOOM-v1.md?plain=1#L547",
