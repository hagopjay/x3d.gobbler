   "@id": "law/29",
   "@type": "Law",
   "n": 29,
   "label": "Law 29: One cause at a time",
   "headline": "One cause at a time",
   "text": "Change only the suspected variable; a correction fitted this way is grade L; a quantity that depends on the analyst's window is reported, not gated",
   "forbids": "Writing a correction for an untested cause",
