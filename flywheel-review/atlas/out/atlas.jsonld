    "pin/x3d.ml@8e2e8da",
    "pin/x3d_mcp@c6681fe",
    "pin/x3d_mcp@dcf0815"
   ]
  },
  {
   "@id": "chapter/23",
   "@type": "Chapter",
   "n": 23,
   "label": "23. Traceability: a quote beside every value, and the lineage stack around it",
   "title": "Traceability: a quote beside every value, and the lineage stack around it",
   "code": "TRC",
   "say": "Make whoever writes a value copy the exact words it came from, and let plain code answer three questions (is the quote in the source, is the value in the quote, where is it); then record the answer in the scene's own hash chain, recompute it on audit, and say out loud what it cannot show: that the quote is the right place, that the value is true, or who wrote the record.",
   "definedAt": "https://github.com/hagopjay/x3d.docs/blob/ff0565e5a248ca391d68527716a58a821f25d152/docs/learn/23-traceability-lineage.md",
   "file": "docs/learn/23-traceability-lineage.md",
   "grade": [
    "grade/C"
   ],
   "requires": [
    "chapter/01",
    "chapter/03",
    "chapter/22"
   ],
