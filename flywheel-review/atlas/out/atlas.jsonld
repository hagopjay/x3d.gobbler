   ]
  },
  {
   "@id": "question/8",
   "@type": "OpenQuestion",
   "n": 8,
   "label": "Open question 8: Two FACTS sections named P",
   "headline": "Two FACTS sections named P",
   "text": "will collide on merge; rename one to P2 [DEF gap 12].",
   "definedAt": "https://github.com/hagopjay/x3d.loom/blob/ba301533d7b66eb8fe5e691524a551ef01c58de1/LOOM-v1.md?plain=1#L595",
