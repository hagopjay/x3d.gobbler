   "@id": "question/9",
   "@type": "OpenQuestion",
   "n": 9,
   "label": "Open question 9: x3d.ML main still serves a private build graph",
   "headline": "x3d.ML main still serves a private build graph",
   "text": "with internal identifiers: remove, or leave [DEF gap 13]?",
