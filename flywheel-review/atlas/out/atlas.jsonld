   "@id": "law/28",
   "@type": "Law",
   "n": 28,
   "label": "Law 28: Explore the worst case before declaring a limit; then fix the instrument, not the threshold",
   "headline": "Explore the worst case before declaring a limit; then fix the instrument, not the threshold",
   "text": "Show a resolution effect by refinement, measure the cause where it lives, keep the red run in history",
   "forbids": "Limits set on easy cases; widened limits",
