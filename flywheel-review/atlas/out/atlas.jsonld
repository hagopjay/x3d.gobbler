   "@type": "Law",
   "n": 37,
   "label": "Law 37: An artefact that claims to stand alone is tested alone",
   "headline": "An artefact that claims to stand alone is tested alone",
   "text": "A saved scene, export or bundle is loaded with nothing of the app around it and compared with the live view",
