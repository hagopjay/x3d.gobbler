   "verify": "`mkdir t && cd t && npm pack x_ite@16.7.0 && tar xzf x_ite-16.7.0.tgz`, then: ```python import re, glob, xml.etree.ElementTree as ET ST = re.compile(r'getStaticProperties \\(\"(\\w+)\",\\s*\"(\\w+)\",\\s*(\\d+),') files = ['package/dist/x_ite.js'] + [f for f in glob.glob('package/dist/assets/components/*.js') if not f.endswith('.min.js')] names = set() for f in files: names |= {m.group(1) for m in ST.finditer(open(f, encoding='utf-8').read())} uom = ET.parse('X3dUnifiedObjectModel-4.1.xml').getroot() # from x3d_mcp src/validation/schemas concrete = {n.get('name') for n in uom.find('ConcreteNodes')} print(len(names), len(concrete), len(names & concrete), len(names - concrete), sorted(concrete - names)) ```",
