   "@id": "law/25",
   "@type": "Law",
   "n": 25,
   "label": "Law 25: Independent witnesses need independent assumptions",
   "headline": "Independent witnesses need independent assumptions",
   "text": "A second implementation in another language is not independent if it shares the coordinate convention, encoding or reference being tested",
   "forbids": "Calling a CPU probe that copies the shader's assumptions a witness",
