   "checkKind": "process",
   "quotedFrom": [
    "doc/x3d.loom@ba30153/LOOM-v1.md"
   ],
   "evidenceGrade": [
    "grade/C"
   ],
   "citesSource": [
    "source/RB1",
    "source/RB2"
   ],
   "inTheme": [
    "theme/I"
   ],
   "paidForBy": [
    "fm/114"
   ]
  },
