   ],
   "inClass": [
    "class/K3"
   ],
   "caughtBy": [
    "diag/PHYS_LIMITS_UNPROVEN"
   ]
  },
  {
   "@id": "fm/157",
   "@type": "FailureMode",
   "n": 157,
   "label": "Failure mode 157",
   "failure": "Two of eleven mutation controls were vacuous: they scaled a reference whose limit was 0 (pairs missed, mismatches), changed nothing, and the checker rightly accepted the record",
   "fix": "Choose a reference with a nonzero limit and require each control to change the record; report caught of total (11 of 11 after the fix)",
   "sourceText": "[x3d.demo PRs #19 to #25, v5/ERRATA-v1-v4.md; C]",
   "definedAt": "https://github.com/hagopjay/x3d.loom/blob/ba301533d7b66eb8fe5e691524a551ef01c58de1/LOOM-v1.md?plain=1#L549",
