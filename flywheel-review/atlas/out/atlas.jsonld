  {
   "@id": "question/11",
   "@type": "OpenQuestion",
   "n": 11,
   "label": "Open question 11: The Scientific Loom governance patch",
   "headline": "The Scientific Loom governance patch",
   "text": "(sha256 5e0aac32…, 4 files, 8 tests) was not delivered. Upload it when found; kit/loomkit/sci.py is a reconstruction until then.",
   "definedAt": "https://github.com/hagopjay/x3d.loom/blob/ba301533d7b66eb8fe5e691524a551ef01c58de1/LOOM-v1.md?plain=1#L598",
